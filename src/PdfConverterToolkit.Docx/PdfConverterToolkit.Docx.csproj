<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfConverterToolkit.Docx</RootNamespace>
    <AssemblyName>PdfConverterToolkit.Docx</AssemblyName>
    <!-- CA1416: o PDFium (PDFtoImage) cobre Windows/Linux/macOS/Android 31+; nao ha alvo fora disso. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Leitura do PDF: letras com posicao/fonte/cor, imagens, vetores (linhas de tabela). -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <!-- Escrita do .docx (Office Open XML). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rasterizacao, caminhos de saida e relatorio de lote. -->
    <ProjectReference Include="..\PdfConverterToolkit.Core\PdfConverterToolkit.Core.csproj" />
  </ItemGroup>

</Project>
