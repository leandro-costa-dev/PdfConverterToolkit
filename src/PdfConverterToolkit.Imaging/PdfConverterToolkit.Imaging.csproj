<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfConverterToolkit.Imaging</RootNamespace>
    <AssemblyName>PdfConverterToolkit.Imaging</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      System.Drawing (GDI+) grava BMP, GIF e TIFF, que o Skia nao codifica — por isso este
      projeto e o unico de biblioteca preso ao Windows. JPEG e PNG saem direto do Skia.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remonta o PDF compactado a partir das paginas rasterizadas. -->
    <PackageReference Include="PdfSharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rasterizacao, caminhos de saida e relatorio de lote. -->
    <ProjectReference Include="..\PdfConverterToolkit.Core\PdfConverterToolkit.Core.csproj" />
  </ItemGroup>

</Project>
